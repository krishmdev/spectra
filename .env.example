GEMINI_API_KEY=key-here

# Voice (Mac mic via scripts/run_server.py): seconds for SpeechRecognition.listen()
# VOICE_TIMEOUT = max wait for you to *start* speaking after tapping the mic
# VOICE_PHRASE_LIMIT = max length of one phrase (long directions requests)
VOICE_TIMEOUT=30
VOICE_PHRASE_LIMIT=60

# WebDriverAgent auto-restart (server/ws_server.py) and scripts/restart_all.sh.
# WDA_PROJ defaults to ~/WebDriverAgent/WebDriverAgent.xcodeproj; restart is skipped if it doesn't exist.
# SIM_UDID wins over SIM_DEVICE when both are set.
# WDA_PROJ=/path/to/WebDriverAgent/WebDriverAgent.xcodeproj
# SIM_UDID=
# SIM_DEVICE=iPhone 17 Pro
