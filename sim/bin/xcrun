#!/usr/bin/env python3
"""Stand-in for `xcrun simctl` when Spectra runs against the mock device.

Put sim/bin first on PATH. `simctl launch booted <bundle>` becomes a POST to
the mock device, `simctl push` is accepted and ignored, anything else fails.
"""
import json
import os
import sys
import urllib.error
import urllib.request

args = sys.argv[1:]
base = os.environ.get('SPECTRA_SIM_URL', 'http://127.0.0.1:8100')

if args[:2] == ['simctl', 'launch'] and len(args) >= 4:
    bundle = args[3]
    req = urllib.request.Request(base + '/_sim/launch', data=json.dumps({'bundle_id': bundle}).encode(),
                                 headers={'Content-Type': 'application/json'}, method='POST')
    try:
        urllib.request.urlopen(req, timeout=5).read()
    except (urllib.error.URLError, OSError):
        print(f'An error was encountered processing the command (code=4):\n'
              f'The request to open "{bundle}" failed.', file=sys.stderr)
        sys.exit(4)
    print(f'{bundle}: 4242')
    sys.exit(0)

if args[:2] == ['simctl', 'push']:
    sys.exit(0)

if args[:2] == ['simctl', 'listapps']:
    print(json.dumps({b: {} for b in ['com.apple.Preferences', 'com.apple.MobileSMS',
                                      'com.apple.reminders', 'com.apple.stocks']}))
    sys.exit(0)

print(f'xcrun (spectra mock): unsupported command: {" ".join(args)}', file=sys.stderr)
sys.exit(1)
